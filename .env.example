# ---------- 基础 ----------
SECRET_KEY=please-change-this-to-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,your.domain.com
CSRF_TRUSTED_ORIGINS=http://your-server-ip:8000,https://your.domain.com
WEB_PORT=8000

# ---------- MySQL（docker-compose 内 db 服务） ----------
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=ai_listing
MYSQL_USER=ai_listing
MYSQL_PASSWORD=change_me_db
MYSQL_PORT=3306

# ---------- 站点 URL（生图 media 公网引用等） ----------
SITE_BASE_URL=http://your-server-ip:8000
NANO_BANANA_MEDIA_PUBLIC_BASE=http://your-server-ip:8000/media
SERVE_MEDIA=true

# ---------- 邮件（忘记密码） ----------
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ---------- OpenAI / 代理 ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai-proxy.org/v1
OPENAI_MODEL=gpt-5.1
OPENAI_VISION_MODEL=gpt-4o

# ---------- Nano Banana 生图 ----------
NANO_BANANA_API_URL=https://grsai.dakka.com.cn/v1/api/generate
NANO_BANANA_API_KEY=

# ---------- Amazon 图片 webhook ----------
AMAZON_IMAGE_WEBHOOK_URL=

# ---------- Helium10（可选，也可在超级管理员设置页配置） ----------
H10_AUTH_TOKEN=
H10_X_TOKEN=
